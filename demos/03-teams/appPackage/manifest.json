{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
    "manifestVersion": "1.17",
    "version": "1.0.0",
    "id": "{{TEAMS_APP_ID}}",
    "packageName": "com.databricks.geniebot",
    "developer": {
        "name": "Databricks MCP Demo",
        "websiteUrl": "https://www.databricks.com",
        "privacyUrl": "https://www.databricks.com/privacy",
        "termsOfUseUrl": "https://www.databricks.com/terms"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Genie Bot",
        "full": "Databricks Genie Analytics Bot"
    },
    "description": {
        "short": "AI-powered data analytics bot",
        "full": "Chat with your data using natural language. Powered by Databricks Genie, Vector Search, and Unity Catalog Functions."
    },
    "accentColor": "#FF3621",
    "bots": [
        {
            "botId": "{{BOT_ID}}",
            "scopes": [
                "personal",
                "team",
                "groupchat"
            ],
            "supportsFiles": false,
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": [
                        "personal",
                        "team",
                        "groupchat"
                    ],
                    "commands": [
                        {
                            "title": "help",
                            "description": "Show available commands and usage examples"
                        },
                        {
                            "title": "reset",
                            "description": "Start a new conversation"
                        }
                    ]
                }
            ]
        }
    ],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "*.databricks.com"
    ]
}
