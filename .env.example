# Databricks Configuration
# Option 1: Use ~/.databrickscfg (recommended for CLI testing)
# Just set GENIE_SPACE_ID and leave others empty
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_PROFILE=DEFAULT

# Option 2: OAuth (for production)
DATABRICKS_OAUTH_CLIENT_ID=
DATABRICKS_OAUTH_CLIENT_SECRET=

# Genie Space ID (required)
# Find this in Databricks UI: SQL → Genie → Your Space → URL contains space_id
# Or run: python scripts/find_genie_space.py --list
GENIE_SPACE_ID=

# Vector Search Configuration
VECTOR_SEARCH_INDEX_ID=demo_retail.ecommerce.documentation_index
VECTOR_SEARCH_ENDPOINT=one-env-shared-endpoint-10

# Unity Catalog Function Name (optional, defaults shown)
UC_FUNCTION_NAME=demo_retail.ecommerce.calculate_discount

# Feature Flags
USE_MOCK_MCP=false

# Slack Configuration (for Slack bot demo)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Teams Configuration (for Teams bot demo)
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
